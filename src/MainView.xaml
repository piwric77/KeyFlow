<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
 <Grid.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Description" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="13"/></Style>
 </Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid x:Name="TitleBar" Background="Transparent"><StackPanel Orientation="Horizontal" Spacing="12" Margin="20,0,0,0" VerticalAlignment="Center"><FontIcon Glyph="&#xE765;" FontSize="16"/><TextBlock Text="KeyFlow" FontSize="13"/></StackPanel></Grid>
 <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" CompactModeThresholdWidth="640" ExpandedModeThresholdWidth="950" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" OpenPaneLength="200" IsPaneOpen="False" PaneTitle="KeyFlow">
  <NavigationView.MenuItems><NavigationViewItem Content="按键动作" Tag="actions"><NavigationViewItem.Icon><FontIcon Glyph="&#xE765;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Content="偏好设置" Tag="preferences"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.MenuItems>
  <NavigationView.PaneFooter><StackPanel x:Name="SideFooter" Visibility="Collapsed" Margin="16,0,16,20" Spacing="8"><TextBlock x:Name="Connection" Text="正在接管按键" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="12"/><TextBlock Text="KeyFlow 3.1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></NavigationView.PaneFooter>
  <Grid Padding="28,14,28,20" RowSpacing="18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="6"><TextBlock x:Name="PageTitle" Text="按键动作" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock x:Name="PageSubtitle" Text="把常用的事，交给顺手的一按。" Style="{StaticResource Description}"/></StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel x:Name="ActionsPage" Spacing="10">
      <Border Style="{StaticResource Card}"><StackPanel Spacing="14"><StackPanel Spacing="3"><TextBlock Text="单击" Style="{StaticResource CardTitle}"/><TextBlock Text="轻按一次，打开你的常用入口" VerticalAlignment="Center" Style="{StaticResource Description}"/></StackPanel><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Target0" PlaceholderText="网址、程序或快捷方式路径"/><Button x:Name="Browse0" Grid.Column="1" Content="选择…"/><Button x:Name="Test0" Grid.Column="2" Content="试运行"/></Grid></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="14"><StackPanel Spacing="3"><TextBlock Text="双击" Style="{StaticResource CardTitle}"/><TextBlock Text="连续轻按两次，切换另一种效率" VerticalAlignment="Center" Style="{StaticResource Description}"/></StackPanel><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Target1" PlaceholderText="留空则不执行"/><Button x:Name="Browse1" Grid.Column="1" Content="选择…"/><Button x:Name="Test1" Grid.Column="2" Content="试运行"/></Grid></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="14"><StackPanel Spacing="3"><TextBlock Text="长按" Style="{StaticResource CardTitle}"/><TextBlock Text="持续按住，松手后执行" VerticalAlignment="Center" Style="{StaticResource Description}"/></StackPanel><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Target2" PlaceholderText="留空则不执行"/><Button x:Name="Browse2" Grid.Column="1" Content="选择…"/><Button x:Name="Test2" Grid.Column="2" Content="试运行"/></Grid></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="找到你的节奏" Style="{StaticResource CardTitle}"/><Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><NumberBox x:Name="DoubleMs" Header="双击间隔（毫秒）" Minimum="180" Maximum="700" SmallChange="25" SpinButtonPlacementMode="Compact"/><NumberBox x:Name="HoldMs" Grid.Column="1" Header="长按阈值（毫秒）" Minimum="400" Maximum="2000" SmallChange="50" SpinButtonPlacementMode="Compact"/></Grid></StackPanel></Border>
      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="从一个入口开始" Message="支持网址、软件和快捷方式。单击会等待双击间隔；长按在松手时执行。"/>
     </StackPanel>
     <StackPanel x:Name="PreferencesPage" Spacing="10" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel Spacing="10"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="联想 SmartKey 兼容接管" Style="{StaticResource CardTitle}"/><TextBlock Text="保留 Fn 服务，接收原厂 SmartKey 消息。" Style="{StaticResource Description}"/></StackPanel><ToggleSwitch x:Name="LenovoSmartKey" AutomationProperties.Name="联想 SmartKey 兼容接管" Grid.Column="1" OffContent="" OnContent="" MinWidth="64" Width="64" VerticalAlignment="Center"/></Grid><TextBlock x:Name="SmartKeyStatus" Text="未启用 · 保存后生效；需要实体按键验证。" Style="{StaticResource Description}"/><TextBlock Text="此接口仅支持单击和双击；长按仍由 Copilot 键的按下／松开事件识别。" Style="{StaticResource Description}"/></StackPanel></Border>

      <Border Style="{StaticResource Card}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="登录 Windows 后自动启动" Style="{StaticResource CardTitle}"/><TextBlock Text="在后台运行，启动时不弹出设置窗口。" Style="{StaticResource Description}"/></StackPanel><ToggleSwitch x:Name="AutoStart" AutomationProperties.Name="登录 Windows 后自动启动" Grid.Column="1" OffContent="" OnContent="" MinWidth="64" Width="64" VerticalAlignment="Center"/></Grid></Border>
      <Border Style="{StaticResource Card}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="隐藏托盘图标" Style="{StaticResource CardTitle}"/><TextBlock Text="保持后台运行；再次双击 KeyFlow 可找回设置。" Style="{StaticResource Description}"/></StackPanel><ToggleSwitch x:Name="HideTray" AutomationProperties.Name="隐藏托盘图标" Grid.Column="1" OffContent="" OnContent="" MinWidth="64" Width="64" VerticalAlignment="Center"/></Grid></Border>
      <Border Style="{StaticResource Card}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="优先调出已有窗口" Style="{StaticResource CardTitle}"/><TextBlock Text="直接指定程序时，优先切换到已运行的窗口。" Style="{StaticResource Description}"/></StackPanel><ToggleSwitch x:Name="FocusExisting" AutomationProperties.Name="优先调出已有窗口" Grid.Column="1" OffContent="" OnContent="" MinWidth="64" Width="64" VerticalAlignment="Center"/></Grid></Border>
      <Border Style="{StaticResource Card}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="同时接管 Win + C" Style="{StaticResource CardTitle}"/><TextBlock Text="启用与 Copilot 键相同的三种手势。" Style="{StaticResource Description}"/></StackPanel><ToggleSwitch x:Name="WinC" AutomationProperties.Name="同时接管 Win + C" Grid.Column="1" OffContent="" OnContent="" MinWidth="64" Width="64" VerticalAlignment="Center"/></Grid></Border>
      <Border Style="{StaticResource Card}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="外观" Style="{StaticResource CardTitle}"/><TextBlock Text="使用 Windows 原生浅色或深色主题。" Style="{StaticResource Description}"/></StackPanel><ComboBox x:Name="Theme" Grid.Column="1" MinWidth="150" VerticalAlignment="Center"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox></Grid></Border>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="5"><TextBlock Text="关于 KeyFlow" Style="{StaticResource CardTitle}"/><TextBlock Text="此项目由 AI 构建（使用 Codex 生成与迭代）。SmartKey 兼容接管仍需实体按键验证。" Style="{StaticResource Description}"/></StackPanel></Border>
      <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="Pause" Content="暂停接管"/><Button x:Name="Exit" Content="退出程序"/></StackPanel>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <StackPanel Grid.Row="2" Spacing="10"><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="Save" Content="保存并生效" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="Hide" Content="收起到后台"/></StackPanel><TextBlock x:Name="Status" Style="{StaticResource Description}"/></StackPanel>
  </Grid>
 </NavigationView>
</Grid>
